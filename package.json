{
  "name": "pi-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "pi 的图形前端：给不愿意使用终端的用户一个窗口来驱动本地 coding agent",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke:engine": "node scripts/engine-smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
